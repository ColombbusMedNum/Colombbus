rules_version = '2';

// Verrou de sécurité réel de la plateforme Colombbus.
//
// Tout ce qui se passe côté React (PageGuard, PermissionGuard, middleware.ts)
// n'est que de l'UX : ça évite d'afficher un bouton ou une page à quelqu'un
// qui n'y a pas droit, pour éviter la confusion. Mais un utilisateur qui
// contourne le JS (devtools, appel direct au SDK Firestore) doit être arrêté
// ICI. C'est cette raison qui a fait migrer les documents liste_mediateurs
// pour que leur ID Firestore soit l'UID Firebase Auth : sans ça, une règle ne
// peut pas faire de lookup de rôle par un simple get() de document.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/liste_mediateurs/$(request.auth.uid));
    }

    // Un membre archivé (equipe.tsx → toggleArchive, actif: false) garde son
    // compte Firebase Auth mais ne doit plus accéder à aucune donnée — sans
    // ce garde-fou, exists() ci-dessous continuerait de renvoyer vrai pour
    // lui indéfiniment. `actif` absent (anciennes fiches) compte comme actif.
    function estActif() {
      return myProfile().data.get('actif', true) != false;
    }

    // "Staff" = a un profil actif dans liste_mediateurs, quel que soit le rôle.
    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/liste_mediateurs/$(request.auth.uid)) && estActif();
    }

    // Insensible à la casse pour matcher la normalisation faite côté client
    // (lib/roles.ts → normalizeRole) : une fiche peut avoir "Admin", "ADMIN"
    // ou "admin" selon comment/quand elle a été créée.
    function myRole() {
      return myProfile().data.get('role', '').lower();
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/liste_mediateurs/$(request.auth.uid)) && estActif() && myRole() == "admin";
    }

    // Rôles couvrant les actions déléguées par un admin à un coordinateur
    // dans lib/permissionsCatalog.ts (gestion d'équipe, validation de
    // semaine, modèles d'activités...). Centralisé ici pour rester en phase
    // avec la matrice de droits sans dupliquer la condition partout.
    function isCoordinateurOuPlus() {
      return isAdmin() || (isStaff() && myRole() == "coordinateur");
    }

    // Profil et rôle de chaque membre du staff. Écriture ouverte au
    // coordinateur (pas seulement l'admin) : equipe_add_member,
    // equipe_member_actions, equipe_create_access et agenda_staff_mask lui
    // sont accordés côté UI (lib/permissionsCatalog.ts) — la règle doit
    // suivre, sans quoi ces boutons échouent pour un vrai coordinateur.
    match /liste_mediateurs/{uid} {
      allow read: if isSignedIn();
      allow write: if isCoordinateurOuPlus();
    }

    // Marqueur "première connexion effectuée", posé par l'utilisateur
    // lui-même depuis app/login/page.tsx pour permettre à /mediation/equipe
    // de retirer le bouton d'envoi de l'e-mail d'activation une fois inutile.
    // Volontairement une collection à part de liste_mediateurs (non
    // modifiable par l'admin) : write-once, un seul document par UID, aucune
    // modification ni suppression possible après coup.
    match /premieres_connexions/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // Matrice centralisée des droits par page/action (lue par
    // PermissionsProvider, éditée uniquement depuis /analyse).
    match /configuration_droits/{actionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Territoires, catalogue de qualités et grilles horaires ACI, gérés
    // depuis /mediation/equipe (anciennement mélangés à tort dans
    // liste_mediateurs sous les ID "parametres_configuration"/
    // "parametres_horaires", ce qui les faisait apparaître comme des
    // médiateurs fantômes dans toute page listant liste_mediateurs sans
    // filtre dédié). Écriture alignée sur les droits déjà accordés côté UI
    // (equipe_territory_manage, equipe_horaires_aci_edit, equipe_modal_competence
    // sont réservés à l'admin et au coordinateur — voir lib/permissionsCatalog.ts).
    match /configuration_equipe/{docId} {
      allow read: if isSignedIn();
      allow write: if isCoordinateurOuPlus();
    }

    // Sessions disponibles par parcours pour le formulaire d'inscription
    // Numérik'Up (voir actions-collectives/inscription/numerik-up) : lecture
    // ouverte à tout le staff, édition réservée à l'admin (seul rôle à voir
    // le panneau de gestion des sessions dans l'UI).
    match /configuration_numerikup/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Inscriptions au parcours Numérik'Up : distinctes de "utilisateurs" car
    // ce sont des candidat.e.s au programme, pas encore des bénéficiaires
    // suivis par Colombbus.
    match /inscriptions_numerikup/{docId} {
      allow read, create: if isStaff();
      allow update, delete: if isCoordinateurOuPlus();
    }

    // Même architecture que Numérik'Up ci-dessus, dupliquée pour Digital'UP et
    // Numérik'UP Pro (voir actions-collectives/reponses/digital-up et
    // .../numerik-up-pro) — mêmes règles, collections distinctes.
    match /configuration_digitalup/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /inscriptions_digitalup/{docId} {
      allow read, create: if isStaff();
      allow update, delete: if isCoordinateurOuPlus();
    }
    match /configuration_numerikuppro/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /inscriptions_numerikuppro/{docId} {
      allow read, create: if isStaff();
      allow update, delete: if isCoordinateurOuPlus();
    }

    // Données opérationnelles : accessibles à tout le staff authentifié
    // (peu importe le rôle précis). C'est la même politique que celle qui
    // prévalait de fait avant cette mise en place de rules (aucune
    // restriction), mais restreinte au moins aux comptes du staff — un
    // découpage plus fin par rôle/action pourra être ajouté collection par
    // collection au fil de l'eau, en s'appuyant sur configuration_droits.
    //
    // Exception : le champ Statut_Blacklist reste protégé (mediateur peut
    // éditer un profil via fiche_modal_submit, mais benef_action_toggle_blacklist
    // et fiche_modal_toggle_blacklist ne sont accordés qu'au coordinateur+ —
    // voir lib/permissionsCatalog.ts) sans bloquer le reste de l'édition.
    match /utilisateurs/{docId} {
      allow read, create: if isStaff();
      allow update: if isStaff() && (
        isCoordinateurOuPlus() ||
        request.resource.data.get('Statut_Blacklist', 'Non') == resource.data.get('Statut_Blacklist', 'Non')
      );
    }
    // Sous-collection "visites" de chaque bénéficiaire (rendez-vous,
    // diagnostics...). Le joker récursif {path=**} est nécessaire — pas
    // seulement /utilisateurs/{docId}/visites/{visiteId} — car plusieurs
    // pages (suresnes, rendez-vous-par-lieu, fiches-bilans) interrogent
    // "visites" via collectionGroup() plutôt qu'un accès direct, et Firestore
    // n'autorise une requête collectionGroup que via cette syntaxe.
    // Suppression réservée au coordinateur+ (fiche_action_delete_rdv) : un
    // médiateur garde le droit de créer/éditer un RDV, pas de l'effacer.
    match /{path=**}/visites/{visiteId} {
      allow read, create, update: if isStaff();
      allow delete: if isCoordinateurOuPlus();
    }
    match /utilisateurs/{docId}/fiches_bilan/{ficheId} {
      allow read, write: if isStaff();
    }
    match /liste_lieux/{docId} {
      allow read, write: if isStaff();
    }
    match /planning_mediateurs/{docId} {
      allow read, write: if isStaff();
    }
    // Réaffectation d'un créneau à un autre médiateur (mediateurNom) réservée
    // au coordinateur+ (suresnes_reassign) ; assigner/vider/éditer un usager
    // sur son propre créneau reste ouvert à tout le staff.
    match /planning_suresnes/{docId} {
      allow read, create, delete: if isStaff();
      allow update: if isStaff() && (
        isCoordinateurOuPlus() ||
        request.resource.data.get('mediateurNom', null) == resource.data.get('mediateurNom', null)
      );
    }
    // Verrouillage hebdomadaire du planning, réservé au coordinateur+
    // (agenda_validate_week).
    match /semaines_validees/{docId} {
      allow read: if isStaff();
      allow write: if isCoordinateurOuPlus();
    }
    // Modèles d'activités (création/édition/suppression réservée au
    // coordinateur+ via agenda_model_create/agenda_model_actions/
    // modeles_create/modeles_edit/modeles_delete). Les créneaux qu'ils
    // génèrent restent dans planning_mediateurs/planning_suresnes, ouverts
    // à tout le staff comme avant.
    match /activites_types/{docId} {
      allow read: if isStaff();
      allow write: if isCoordinateurOuPlus();
    }
    // Couleur de chaque bloc thématique (Inclusion Numérique, Découverte
    // Métiers, Insertion Professionnelle) — voir app/agenda/page.tsx.
    match /blocs_config/{blocId} {
      allow read, write: if isStaff();
    }
    match /actions_collectives/{docId} {
      allow read, write: if isStaff();
    }
    match /fiches_bilans/{docId} {
      allow read, write: if isStaff();
    }
    match /notifications/{docId} {
      allow read, write: if isStaff();
    }
    match /lieux_emargement/{docId} {
      allow read, write: if isStaff();
    }
    match /logos_emargement/{docId} {
      allow read, write: if isStaff();
    }

    // Tout le reste est refusé par défaut.
  }
}
