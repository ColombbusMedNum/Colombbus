rules_version = '2';

// Verrou de sécurité réel pour Firebase Storage — même principe que
// firestore.rules : le PageGuard/PermissionGuard côté React n'est que de
// l'UX, ce fichier est la barrière qui compte réellement.
//
// isStaff() se limite ici à "connecté à un compte Firebase Auth de ce
// projet" — pas de vérification croisée du statut actif/archivé dans
// Firestore (liste_mediateurs) comme dans firestore.rules, car les appels
// multiservices Storage → Firestore exigent une autorisation IAM
// supplémentaire (rôle "Firebase Rules Firestore Service Agent" sur le
// compte de service @gcp-sa-firebasestorage) non configurée sur ce projet.
// Cette simplification reste sûre : aucun compte n'existe dans ce projet en
// dehors du staff Colombbus (créés uniquement par un admin, jamais
// d'inscription publique — voir app/mediation/equipe/page.tsx).
service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null;
    }

    // Émargements & documents internes (voir
    // app/mediation/rencontres-numeriques/emargements/page.tsx) — PDF
    // hébergés directement ici plutôt que sur Google Drive, pour éviter la
    // demande d'autorisation Google à chaque ouverture.
    match /emargements/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Par défaut, tout le reste du bucket reste fermé.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
