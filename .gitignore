# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cache local Firebase CLI (firebase deploy, firebase target...)
.firebase

# typescript
*.tsbuildinfo
next-env.d.ts

# clé de compte de service Firebase (accès admin complet — ne jamais commiter)
# motif large pour couvrir toute variante de nom (ex: double extension .json.json
# laissée par un navigateur qui re-suffixe un fichier déjà nommé "...json")
*serviceAccountKey*

.vercel
